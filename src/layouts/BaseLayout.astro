---
// Base page shell: <html lang dir>, head (SEO, icons, fonts), skip link, header, main, footer, WhatsApp button.
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
// Arabic-script subsets only (Latin words on Arabic pages use Montserrat, already loaded for the logo).
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@/styles/global.css';
// Headline weight preloaded per script so the hero title (the LCP element) renders in its final font quickly.
// Arabic ships 400 + 700 only: medium (500) renders as 400 and semibold (600) as 700, saving ~90 KB on slow networks.
import montserrat700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import plexArabic700 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';

import Seo from '@/components/Seo.astro';
import SkipLink from '@/components/SkipLink.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import ChatLauncher from '@/components/ChatLauncher.astro';
import Analytics from '@/components/Analytics.astro';
import PreloaderGate from '@/components/PreloaderGate.astro';
import Preloader from '@/components/Preloader.astro';
import { type Locale, getDictionary, getDir, withBase } from '@/i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Show the first-visit brand preloader (home page only). */
  preloader?: boolean;
}
const { locale, title, description, noindex, preloader = false } = Astro.props;
const t = getDictionary(locale);
---

<!doctype html>
<html lang={locale} dir={getDir(locale)}>
  <head>
    <meta charset="utf-8" />
    {preloader && <PreloaderGate />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081D3A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="preload" href={locale === 'ar' ? plexArabic700 : montserrat700} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <Seo locale={locale} title={title} description={description} noindex={noindex} />
    <slot name="head" />
    <Analytics />
  </head>
  <body class="bg-navy font-sans text-ink antialiased">
    {preloader && <Preloader />}
    <SkipLink label={t.a11y.skipToContent} />
    <Header locale={locale} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatLauncher locale={locale} />
    <WhatsAppFloat locale={locale} />
  </body>
</html>
