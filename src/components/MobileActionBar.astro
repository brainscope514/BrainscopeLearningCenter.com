---
// Phone/tablet bottom action bar (below lg): Free trial · WhatsApp · Call · Ask (opens the assistant).
// Replaces the floating circles on small screens. Hides while a text field is focused so it never sits on the keyboard.
import Icon from './Icon.astro';
import { type Locale, getDictionary, trialHref } from '@/i18n';
import { telLink, whatsappLink } from '@/data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const a = t.actionBar;
const item =
  'flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg px-1 text-[0.6875rem] font-semibold text-ink-muted transition-colors hover:bg-white/5 hover:text-white';
---

<nav class="action-bar fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-navy-900/95 backdrop-blur-md lg:hidden" aria-label={a.label} data-action-bar>
  <div class="mx-auto grid max-w-xl grid-cols-[1.6fr_1fr_1fr_1fr] items-center gap-1 px-2 pt-1.5 pb-[max(0.375rem,env(safe-area-inset-bottom))]">
    <a
      href={trialHref(locale)}
      class="me-1 inline-flex min-h-12 items-center justify-center rounded-pill bg-purple px-3 text-sm font-semibold whitespace-nowrap text-white shadow-glow-purple"
    >
      {a.book}
    </a>
    <a href={whatsappLink(t.whatsapp.general)} target="_blank" rel="noopener" class={item}>
      <Icon name="whatsapp" class="size-5 text-[#25D366]" />
      <span>{a.whatsapp}<span class="sr-only"> {t.a11y.opensInNewTab}</span></span>
    </a>
    <a href={telLink()} class={item}>
      <Icon name="phone" class="size-5 text-electric" />
      <span>{a.call}</span>
    </a>
    <button
      type="button"
      class={item}
      aria-expanded="false"
      aria-controls="brainscope-chat"
      data-chat-launcher
    >
      <svg class="size-5 text-violet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.6A8 8 0 1 1 21 12Z"></path>
        <path d="M9 11h.01M12 11h.01M15 11h.01" stroke-width="2.4"></path>
      </svg>
      <span>{a.chat}</span>
    </button>
  </div>
</nav>

<style>
  .action-bar {
    transition: transform 0.25s var(--ease-brand);
  }
  .action-bar.is-hidden {
    transform: translateY(110%);
  }
  @media (prefers-reduced-motion: reduce) {
    .action-bar {
      transition: none;
    }
  }
  /* Room at the end of the page so the bar never covers the footer. */
  @media (max-width: 1023.98px) {
    :global(body) {
      padding-bottom: calc(4.25rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  // Slide the bar away while typing (the on-screen keyboard would otherwise push it over the form).
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  if (bar) {
    const isTextField = (el: EventTarget | null) =>
      el instanceof HTMLElement && el.matches('input:not([type=radio]):not([type=checkbox]), textarea, select');
    document.addEventListener('focusin', (e) => bar.classList.toggle('is-hidden', isTextField(e.target)));
    document.addEventListener('focusout', () => {
      requestAnimationFrame(() => bar.classList.toggle('is-hidden', isTextField(document.activeElement)));
    });
  }
</script>
