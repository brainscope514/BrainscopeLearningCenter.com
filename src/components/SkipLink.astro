---
// Keyboard "skip to content" link, visible only when focused.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-navy"
  >{label}</a
>
