---
// Founders: one short bio paragraph per founder, with PLACEHOLDER portraits.
// Professional background wording is approved by the founders and lives in the bio text (src/i18n).
import Section from './Section.astro';
import Button from './Button.astro';
import Placeholder from './Placeholder.astro';
import { type Locale, getDictionary } from '@/i18n';
import { whatsappLink } from '@/data/site';

interface Props {
  locale: Locale;
}
const t = getDictionary(Astro.props.locale);
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');
---

<Section id="founders" eyebrow={t.founders.eyebrow} title={t.founders.title} intro={t.founders.intro} tone="light">
  <ul class="mt-14 grid gap-8 lg:grid-cols-2" data-reveal="stagger">
    {
      t.founders.people.map((person) => (
        <li class="grid gap-6 rounded-xl border border-white/10 bg-navy-800/70 p-6 shadow-card sm:grid-cols-[9rem_1fr] sm:p-8">
          <Placeholder label={t.founders.portrait} initials={initials(person.name)} ratio="4 / 5" class="max-sm:max-w-36" />
          <div>
            <h3 class="text-2xl font-bold text-white" dir="auto">{person.name}</h3>
            <p class="mt-1 text-sm font-semibold text-violet">{person.role}</p>
            <p class="mt-4 leading-relaxed text-ink-muted">{person.bio}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <Fragment slot="cta">
    <Button href={whatsappLink(t.whatsapp.general)} variant="secondary" icon="whatsapp" external newTabLabel={t.a11y.opensInNewTab}>
      {t.sectionCta.ask}
    </Button>
  </Fragment>
</Section>
