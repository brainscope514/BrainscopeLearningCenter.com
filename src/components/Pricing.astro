---
// Pricing: plan cards when FLAGS.SHOW_PRICING is true; otherwise a single "pilot program details on WhatsApp" card.
import Section from './Section.astro';
import Button from './Button.astro';
import LineIcon from './LineIcon.astro';
import { type Locale, getDictionary, trialHref } from '@/i18n';
import { FLAGS, whatsappLink } from '@/data/site';

interface Props {
  locale: Locale;
}
const t = getDictionary(Astro.props.locale);
---

{
  FLAGS.SHOW_PRICING ? (
    <Section id="pricing" eyebrow={t.pricing.eyebrow} title={t.pricing.title} intro={t.pricing.intro} tone="deep">
      <ul class="mt-14 grid gap-6 md:grid-cols-3" data-reveal="stagger">
        {t.pricing.plans.map((plan) => (
          <li class="flex flex-col rounded-xl border border-white/10 bg-navy-800/80 p-7 shadow-card">
            <h3 class="text-xl font-bold text-white">{plan.name}</h3>
            <p class="mt-4 text-3xl font-bold text-white">
              {plan.price}
              <span class="ms-1 text-base font-medium text-ink-muted">{t.pricing.perMonth}</span>
            </p>
            <ul class="mt-6 space-y-2 text-sm text-ink-muted">
              {plan.features.map((f) => (
                <li class="flex gap-2">
                  <LineIcon name="check" class="mt-0.5 size-4 shrink-0 text-electric" />
                  {f}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <Fragment slot="cta">
        <Button href={trialHref(Astro.props.locale)} arrow>
          {t.cta.bookTrial}
        </Button>
      </Fragment>
    </Section>
  ) : (
    <section id="pricing" aria-labelledby="pricing-title" class="bg-navy-900 py-16">
      <div class="container-brand">
        <div
          class="relative overflow-hidden rounded-2xl border border-violet/40 bg-[linear-gradient(135deg,rgb(106_44_255/0.28),rgb(8_29_58/0.9)_60%)] p-8 shadow-glow-purple lg:flex lg:items-center lg:justify-between lg:gap-10 lg:p-12"
          data-reveal
        >
          <div class="max-w-2xl">
            <p class="text-sm font-semibold tracking-[0.18em] text-electric uppercase">{t.pricing.eyebrow}</p>
            <h2 id="pricing-title" class="mt-3 text-2xl font-bold text-white lg:text-3xl">{t.pricing.pilotTitle}</h2>
            <p class="mt-3 text-ink-muted">{t.pricing.pilotText}</p>
          </div>
          <div class="mt-8 shrink-0 lg:mt-0">
            <Button href={whatsappLink(t.pricing.pilotMessage)} icon="whatsapp" external newTabLabel={t.a11y.opensInNewTab}>
              {t.pricing.pilotCta}
            </Button>
          </div>
        </div>
      </div>
    </section>
  )
}
