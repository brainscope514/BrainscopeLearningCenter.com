---
// University Support: field cards, each with an "Ask on WhatsApp" link pre-filled with the field (no trial CTA here).
import Section from './Section.astro';
import Button from './Button.astro';
import IconBadge from './IconBadge.astro';
import Icon from './Icon.astro';
import { type Locale, getDictionary, fill } from '@/i18n';
import { whatsappLink } from '@/data/site';

interface Props {
  locale: Locale;
}
const t = getDictionary(Astro.props.locale);
const ICONS: Record<string, string> = {
  mechatronics: 'mechatronics',
  ai: 'ai',
  law: 'law',
  journalism: 'journalism',
  marketing: 'marketing',
  more: 'more',
};
const generic = t.university.fields.find((f) => f.id === 'more');
---

<Section id="university" eyebrow={t.university.eyebrow} title={t.university.title} intro={t.university.intro} tone="circuit">
  <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
    {
      t.university.fields.map((field) => (
        <li class="group relative flex flex-col rounded-xl border border-white/10 bg-navy-800/85 p-6 shadow-card transition-[border-color,box-shadow] duration-300 hover:border-violet/50 hover:shadow-glow-purple">
          <IconBadge name={ICONS[field.id] ?? 'more'} />
          <h3 class="mt-5 text-lg font-bold text-white">{field.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{field.text}</p>
          <a
            href={whatsappLink(fill(t.university.waMessage, { field: field.title }))}
            target="_blank"
            rel="noopener"
            class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-violet after:absolute after:inset-0 after:rounded-xl hover:text-white"
          >
            <Icon name="whatsapp" class="size-4" />
            {t.university.ask}
            <span class="sr-only">: {field.title} {t.a11y.opensInNewTab}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <Fragment slot="cta">
    <Button
      href={whatsappLink(fill(t.university.waMessage, { field: generic?.title ?? '' }))}
      icon="whatsapp"
      external
      newTabLabel={t.a11y.opensInNewTab}
    >
      {t.university.ask}
    </Button>
  </Fragment>
</Section>
