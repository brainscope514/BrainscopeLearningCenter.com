---
// Sticky site header: logo, primary nav, language switcher, "Book a free trial" CTA, mobile drawer.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Locale, getDictionary, localizedPath, stripLocale, trialHref } from '@/i18n';
import { NAV_ITEMS, sectionHref, sectionPage } from '@/data/nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
// Current page slug ('' = home) so the matching nav item gets aria-current="page".
const current = stripLocale(Astro.url.pathname).replace(/^\/|\/$/g, '');
const items = NAV_ITEMS.map((item) => ({
  label: t.nav[item.key],
  href: sectionHref(locale, item.section),
  active: sectionPage(item.section) === current,
}));
const trial = trialHref(locale);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-navy/85 backdrop-blur-md">
  <div class="container-brand flex h-16 items-center gap-4 lg:h-20">
    <a href={localizedPath(locale)} class="shrink-0">
      <Logo />
      <span class="sr-only">{t.a11y.homeLink}</span>
    </a>

    <nav aria-label={t.a11y.mainNav} class="ms-auto hidden xl:block">
      <ul class="flex items-center">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class="nav-link rounded-md px-2 py-2 text-[0.8125rem] font-medium whitespace-nowrap 2xl:px-3 2xl:text-sm text-ink-muted transition-colors hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ms-auto hidden items-center gap-3 lg:flex xl:ms-0">
      <LanguageSwitcher locale={locale} />
      <a
        href={trial}
        class="inline-flex min-h-11 items-center rounded-pill bg-purple px-5 text-sm whitespace-nowrap font-semibold text-white shadow-glow-purple transition-transform duration-200 ease-brand hover:-translate-y-0.5"
        >{t.cta.bookTrial}</a
      >
    </div>

    <button
      type="button"
      class="ms-auto inline-flex size-11 items-center justify-center rounded-md text-white hover:bg-white/10 lg:ms-0 xl:hidden"
      aria-label={t.a11y.openMenu}
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <Icon name="menu" class="size-6" />
    </button>
  </div>

  <dialog
    id="mobile-menu"
    aria-label={t.a11y.mainNav}
    class="mobile-drawer m-0 ms-auto h-dvh max-h-none w-[min(22rem,88vw)] max-w-none bg-navy-900 p-0 text-white backdrop:bg-black/60"
  >
    <div class="flex min-h-full flex-col gap-6 p-6 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <div class="flex items-center justify-between">
        <Logo markOnly />
        <button
          type="button"
          class="inline-flex size-11 items-center justify-center rounded-md hover:bg-white/10"
          aria-label={t.a11y.closeMenu}
          data-menu-close
        >
          <Icon name="close" class="size-6" />
        </button>
      </div>
      <nav aria-label={t.a11y.mainNav}>
        <ul class="flex flex-col gap-1">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  data-menu-link
                  class="nav-link block rounded-md px-4 py-3 text-lg font-semibold hover:bg-white/5"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a
        href={trial}
        data-menu-link
        class="inline-flex min-h-12 items-center justify-center rounded-pill bg-purple px-5 font-semibold text-white shadow-glow-purple"
        >{t.cta.bookTrial}</a
      >
      <div class="mt-auto border-t border-white/10 pt-4">
        <LanguageSwitcher locale={locale} variant="full" />
      </div>
    </div>
  </dialog>
</header>

<style>
  /* Drawer slides in from the inline-end edge (right in LTR, left in RTL). Pinned to the viewport and
     scrollable inside, so short phones (and landscape) can reach every link. */
  .mobile-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-start: auto;
    inset-inline-end: 0;
    height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* Page behind the open drawer does not scroll (iOS keeps scrolling the body otherwise). */
  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }
  .nav-link[aria-current='page'] {
    color: var(--color-white, #fff);
    background: rgb(106 44 255 / 0.18);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-drawer[open] {
      animation: drawer-in 0.32s var(--ease-brand);
    }
    :global([dir='rtl']) .mobile-drawer[open] {
      animation-name: drawer-in-rtl;
    }
  }
  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes drawer-in-rtl {
    from {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  // Mobile drawer: native <dialog> gives focus trapping + Escape-to-close.
  // Fixes: body scroll is locked while open; tapping a link closes the drawer WITHOUT moving focus back to the
  // burger (that focus call was cancelling the scroll/navigation on iOS); the drawer closes if the screen grows
  // past the breakpoint where the full nav is shown.
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && opener) {
    let restoreFocus = true;
    const root = document.documentElement;
    const close = (focusOpener = true) => {
      restoreFocus = focusOpener;
      if (dialog.open) dialog.close();
    };
    opener.addEventListener('click', () => {
      dialog.showModal();
      root.classList.add('menu-open');
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.addEventListener('close', () => {
      root.classList.remove('menu-open');
      opener.setAttribute('aria-expanded', 'false');
      if (restoreFocus) opener.focus({ preventScroll: true });
      restoreFocus = true;
    });
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => close());
    dialog.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => close(false)));
    // Click on the backdrop closes the drawer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => {
      if (e.matches) close(false);
    });
    // Back/forward cache: never restore a page with the drawer still open.
    window.addEventListener('pageshow', () => close(false));
  }
</script>
