---
// First-visit preloader (≤ 1.2 s, pure CSS so slow JS never extends it): the brand mark glows in,
// then the panel wipes up to reveal the hero. Shown only when html.bs-preload is set by PreloaderGate.
// The image is lazy so it is never downloaded while the preloader is hidden (mobile, repeat visits).
import { Image } from 'astro:assets';
import emblem from '@/assets/brand/emblem.png';
---

<div class="bs-preloader" aria-hidden="true">
  <div class="bs-preloader__glow"></div>
  <Image src={emblem} alt="" class="bs-preloader__mark" width={128} densities={[1, 2]} loading="lazy" />
</div>

<style is:global>
  .bs-preloader {
    display: none;
  }
  html.bs-preload .bs-preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--color-navy);
    pointer-events: none;
    animation: bs-wipe 0.45s var(--ease-brand) 0.75s forwards;
  }
  .bs-preloader__glow {
    position: absolute;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(106 44 255 / 0.55), rgb(106 44 255 / 0) 65%);
    opacity: 0;
    transform: scale(0.6);
    animation: bs-glow 0.9s ease-out forwards;
  }
  .bs-preloader__mark {
    position: relative;
    width: 8rem;
    height: auto;
    opacity: 0;
    transform: scale(0.85);
    animation: bs-mark-in 0.6s var(--ease-brand) 0.05s forwards;
  }
  @keyframes bs-glow {
    60% {
      opacity: 1;
    }
    to {
      opacity: 0.8;
      transform: scale(1);
    }
  }
  @keyframes bs-mark-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes bs-wipe {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
</style>
