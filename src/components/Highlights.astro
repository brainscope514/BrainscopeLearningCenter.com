---
// Strip below the hero: what Brainscope offers (with "coming soon" items), plus counters once confirmed stats exist.
import Button from './Button.astro';
import IconBadge from './IconBadge.astro';
import { type Locale, getDictionary, trialHref } from '@/i18n';
import { STATS } from '@/data/stats';

interface Props {
  locale: Locale;
  id: string;
}
const { locale, id } = Astro.props;
const t = getDictionary(locale);
const labels = t.highlights.statLabels as Record<string, string>;
const stats = STATS.filter((s) => labels[s.id]);

---

<section id={id} class="relative border-y border-white/10 bg-navy-900/60" aria-labelledby={`${id}-title`}>
  <div class="container-brand py-14 lg:py-16">
    <h2 id={`${id}-title`} class="text-sm font-semibold tracking-[0.18em] text-violet uppercase" data-reveal>
      {t.highlights.heading}
    </h2>

    {
      stats.length > 0 ? (
        <dl class="mt-8 grid grid-cols-2 gap-8 lg:grid-cols-4" data-reveal="stagger">
          {stats.map((s) => (
            <div class="flex flex-col">
              <dt class="text-ink-muted">{labels[s.id]}</dt>
              <dd class="order-first text-4xl font-bold text-white" data-counter={s.value} data-counter-suffix={s.suffix}>
                {s.value}
                {s.suffix}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <ul class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
          {t.highlights.items.map((item) => (
            <li class="flex gap-4" data-tilt="4">
              <IconBadge name={item.icon} />
              <span>
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-lg font-bold text-white">
                  {item.title}
                  {item.soon && (
                    <span class="rounded-pill border border-magenta/50 bg-magenta/10 px-2 py-0.5 text-xs font-semibold text-[#ff8fbf]">
                      {t.highlights.comingSoon}
                    </span>
                  )}
                </span>
                <span class="mt-1 block text-sm text-ink-muted">{item.text}</span>
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10" data-reveal>
      <Button href={trialHref(Astro.props.locale)} arrow>
        {t.cta.bookTrial}
      </Button>
    </div>
  </div>
</section>
