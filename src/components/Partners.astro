---
// Collaborations: confirmed partner academies / institutions (src/data/partners.ts, hidden while empty)
// and the ways institutions can collaborate, ending with a "Become a partner" WhatsApp CTA.
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Button from './Button.astro';
import IconBadge from './IconBadge.astro';
import { type Locale, getDictionary } from '@/i18n';
import { whatsappLink } from '@/data/site';
import { PARTNERS } from '@/data/partners';

interface Props {
  locale: Locale;
}
const t = getDictionary(Astro.props.locale);
---

<Section id="partners" eyebrow={t.partners.eyebrow} title={t.partners.title} intro={t.partners.intro} tone="circuit">
  {
    PARTNERS.length > 0 && (
      <>
        <h3 class="mt-14 text-xl font-bold text-white" data-reveal>
          {t.partners.listTitle}
        </h3>
        <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" data-reveal="stagger">
          {PARTNERS.map((partner) => {
            const content = partner.logo ? (
              <Image src={partner.logo} alt={partner.name} height={64} class="mx-auto h-16 w-auto object-contain" />
            ) : (
              <span class="font-semibold text-white">{partner.name}</span>
            );
            return (
              <li class="grid min-h-28 place-items-center rounded-xl border border-white/10 bg-white/[0.04] p-4 text-center">
                {partner.url ? (
                  <a href={partner.url} target="_blank" rel="noopener" class="hover:opacity-80">
                    {content}
                  </a>
                ) : (
                  content
                )}
              </li>
            );
          })}
        </ul>
      </>
    )
  }

  <h3 class="mt-14 text-xl font-bold text-white" data-reveal>{t.partners.offerTitle}</h3>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
    {
      t.partners.offers.map((offer) => (
        <li class="rounded-xl border border-white/10 bg-navy-800/80 p-6 shadow-card">
          <IconBadge name={offer.icon} />
          <h4 class="mt-5 text-lg font-bold text-white">{offer.title}</h4>
          <p class="mt-2 text-sm text-ink-muted">{offer.text}</p>
        </li>
      ))
    }
  </ul>
  <Fragment slot="cta">
    <Button href={whatsappLink(t.partners.waMessage)} icon="whatsapp" external newTabLabel={t.a11y.opensInNewTab}>
      {t.partners.cta}
    </Button>
  </Fragment>
</Section>
