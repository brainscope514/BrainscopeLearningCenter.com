---
// 404 page (GitHub Pages serves /404.html for every missing URL). Shows the message in EN, FR and AR;
// a small script keeps only the visitor's language (from the URL prefix or saved choice). All three show without JS.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOCALES, getDictionary, getDir, localizedPath } from '@/i18n';

const en = getDictionary('en');
---

<BaseLayout locale="en" title={en.notFound.title} noindex>
  <section class="bg-circuit flex min-h-[70vh] items-center">
    <div class="container-brand grid gap-10 py-section md:grid-cols-3">
      {
        LOCALES.map((code) => {
          const t = getDictionary(code);
          return (
            <div lang={code} dir={getDir(code)} data-404={code}>
              <p class="text-6xl font-bold text-violet">404</p>
              <h1 class="mt-4 text-3xl font-bold text-white">{t.notFound.title}</h1>
              <p class="mt-3 text-ink-muted">{t.notFound.text}</p>
              <a
                href={localizedPath(code)}
                class="mt-6 inline-flex min-h-12 items-center rounded-pill bg-purple px-6 font-semibold text-white shadow-glow-purple"
              >
                {t.notFound.home}
              </a>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Keep only the visitor's language: URL prefix (/fr/…) first, then the saved choice.
  const codes = ['en', 'fr', 'ar'];
  const fromPath = location.pathname.split('/').find((s) => codes.includes(s));
  let saved: string | null = null;
  try {
    saved = localStorage.getItem('bs-locale');
  } catch {
    /* storage unavailable */
  }
  const pick = fromPath ?? (saved && codes.includes(saved) ? saved : null);
  if (pick) {
    document.querySelectorAll<HTMLElement>('[data-404]').forEach((block) => {
      if (block.dataset['404'] !== pick) block.remove();
      else block.parentElement?.classList.remove('md:grid-cols-3');
    });
  }
</script>
