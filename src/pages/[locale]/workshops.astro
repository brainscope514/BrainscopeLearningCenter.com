---
// Workshops page: workshop catalogue and collaborations with schools and institutions.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Workshops from '@/components/Workshops.astro';
import Partners from '@/components/Partners.astro';
import { LOCALES, type Locale, getDictionary } from '@/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.nav.workshops}>
  <Workshops locale={locale} headingLevel="h1" />
  <Partners locale={locale} />
</BaseLayout>
