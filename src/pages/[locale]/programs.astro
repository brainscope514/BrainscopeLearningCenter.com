---
// Programs page: every program as a filterable card with a details popup, then the student pathway.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProgramCatalog from '@/components/ProgramCatalog.astro';
import Pathway from '@/components/Pathway.astro';
import { LOCALES, type Locale, getDictionary } from '@/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.nav.programs}>
  <ProgramCatalog locale={locale} />
  <Pathway locale={locale} />
</BaseLayout>
