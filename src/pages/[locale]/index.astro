---
// Home page: hero, the four program families (each links to its own page) and a 3-question FAQ preview.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Programs from '@/components/Programs.astro';
import Faq from '@/components/Faq.astro';
import { LOCALES, type Locale } from '@/i18n';
import { HOME_FAQ_IDS } from '@/data/faq';
import { pagePath } from '@/data/nav';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} preloader>
  <Hero locale={locale} nextId="programs" />
  <Programs locale={locale} />
  <Faq locale={locale} id="faq-top" ids={HOME_FAQ_IDS} seeAllHref={pagePath(locale, 'faq')} tone="light" />
</BaseLayout>
