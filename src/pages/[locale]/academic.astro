---
// Academic page: school academic support (incl. agenda coaching) and university support.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Academic from '@/components/Academic.astro';
import University from '@/components/University.astro';
import { LOCALES, type Locale, getDictionary } from '@/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.nav.academic}>
  <Academic locale={locale} headingLevel="h1" />
  <University locale={locale} />
</BaseLayout>
